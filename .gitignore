# Entornos virtuales y configuración local
.venv/
venv/
env/
.env
.env.*
!.env.example

# Cachés y artefactos generados
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
build/
dist/
*.egg-info/

# Datos y archivos temporales locales
*.log
/data/raw/*
!/data/raw/.gitkeep
/data/cleaned/*
!/data/cleaned/.gitkeep
.DS_Store
.vscode/
AGENTS.md

# Artefactos del modelo de ML: se versionan el modelo nativo de referencia y su
# metadata para que `docker compose up` pueda predecir sin reentrenar. El joblib
# y el informe de comparación son artefactos locales.
src/ml/artifacts/*
!src/ml/artifacts/delay_risk_xgb.json
!src/ml/artifacts/model_metadata.json