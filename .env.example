# Directorio con delay_risk_xgb.json y model_metadata.json.
# En local (uvicorn) se resuelve desde la raíz del repositorio.
# En Docker Compose se sobrescribe a /app/src/ml/artifacts.
MODEL_ARTIFACT_DIR=src/ml/artifacts

# Webhook opcional para alertas preventivas de riesgo alto.
# Si WEBHOOK_URL está vacío, no se envían alertas.
WEBHOOK_URL=
WEBHOOK_MAX_ATTEMPTS=3

# URL que usa el dashboard para hablar con la API.
# En Docker Compose se sobrescribe a http://api:8000.
API_BASE_URL=http://127.0.0.1:8000

# Puertos publicados en el host y directorio de artefactos montado por Compose.
API_PORT=8000
DASHBOARD_PORT=8501
MODEL_ARTIFACT_HOST_DIR=./src/ml/artifacts
